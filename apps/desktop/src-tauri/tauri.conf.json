{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Platter",
  "identifier": "io.github.mspiechowicz.platter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Platter",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 680,
        "backgroundColor": "#0a0e17"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; base-uri 'self'; object-src 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Utility",
    "license": "GPL-3.0-or-later",
    "shortDescription": "Local disk-space analyzer",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
