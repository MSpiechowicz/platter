{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Platter",
  "identifier": "io.github.mspiechowicz.platter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Platter",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 680,
        "backgroundColor": "#0a0e17"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; base-uri 'self'; object-src 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis",
      "app",
      "dmg"
    ],
    "category": "Utility",
    "license": "GPL-3.0-or-later",
    "publisher": "MSpiechowicz",
    "shortDescription": "Local disk-space analyzer",
    "longDescription": "Platter scans a disk and shows what takes its space: a map of folders, the largest files, and suggestions of what is safe to clean, all on your own computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBMDFGQjY1ODdFNjMxQTgKUldTb01lYUhaZnNCV3JMMEpwV0dtQ0cvdDN4USs3OUV4dDcyeXVBK2o1M1UyaHp1YkZsU1p5MzIK",
      "endpoints": [
        "https://github.com/MSpiechowicz/platter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
